      "name": "Categorias",
      "item": [
        {
          "name": "Crear categorias",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const jsonData = pm.response.json();",
                  "pm.collectionVariables.set(\"categoria_id\", jsonData.data.id);",
                  "",
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Response body has a data property\", function () {",
                  "    pm.expect(jsonData).to.have.property(\"data\");",
                  "});",
                  "pm.test(\"data has required fields\", function () {",
                  "    pm.expect(jsonData.data).to.have.property(\"id\");",
                  "    pm.expect(jsonData.data).to.have.property(\"nombre\");",
                  "    pm.expect(jsonData.data).to.have.property(\"descripcion\");",
                  "    pm.expect(jsonData.data).to.have.property(\"created_at\");",
                  "    pm.expect(jsonData.data).to.have.property(\"updated_at\");",
                  "});",
                  "pm.test(\"data.nombre equals 'CATEGORIA NUEVA CREADA'\", function () {",
                  "    pm.expect(jsonData.data.nombre).to.eql(\"CATEGORIA NUEVA CREADA\");",
                  "});",
                  "pm.test(\"Response time is under 2000ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});"
                ]
              }
            }
          ],
